# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Gmail SMTP (contact form) ───────────────────────────────
# 1. Enable 2-Step Verification on the Gmail / Workspace account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password (no spaces) below
GMAIL_USER=your-sending-address@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where leads from the contact form are delivered
CONTACT_RECIPIENT=support@immigrationadviceservice.org

# Optional — for the 21st.dev component generator
TWENTYFIRST_API_KEY=
